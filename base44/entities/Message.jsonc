{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "ID of the conversation this message belongs to"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of the message sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Name of the sender"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether message has been read"
    }
  },
  "required": [
    "conversation_id",
    "sender_email",
    "content"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "conversation_id": {
            "$in": [
              "{{user.conversation_ids_as_creator}}",
              "{{user.conversation_ids_as_client}}"
            ]
          }
        }
      ]
    },
    "read": {
      "conversation_id": {
        "$in": [
          "{{user.conversation_ids_as_creator}}",
          "{{user.conversation_ids_as_client}}"
        ]
      }
    },
    "update": {
      "data.sender_email": "{{user.email}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}